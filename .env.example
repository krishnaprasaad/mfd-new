# Required: use a long random secret (at least 32 characters) for signed sessions.
JWT_SECRET=replace-with-a-random-secret
MONGODB_URI=mongodb+srv://replace-with-your-connection-string

# LangChain model provider. Use OPENAI_API_KEY or GROQ_API_KEY, or set AI_API_KEY
# with AI_BASE_URL for another OpenAI-compatible provider.
AI_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=
# Groq's current default; override only with an active model ID for your provider.
# AI_MODEL=openai/gpt-oss-120b

# Public fund market data MCP server.
MCP_SERVER_URL=https://mcp.sukoon.money/mcp

# Optional admin login configuration. Admin login is disabled when either is missing.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
