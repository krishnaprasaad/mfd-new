{
    "buildCommand": "npm install --include=dev && npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/[...path].js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/[...path].js"
        }
    ]
}